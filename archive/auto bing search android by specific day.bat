IF %dow% == 1 SET day=TQVIDOLOREMIPSVMQVIA
IF %dow% == 2 SET day=DOLORSITAMETCONSECTA
IF %dow% == 3 SET day=Anovelisalongnarrati
IF %dow% == 4 SET day=easyandefficienteasy
IF %dow% == 5 SET day=findreadingsentences
