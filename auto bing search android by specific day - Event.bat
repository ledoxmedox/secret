@echo off

for /f "tokens=2 delims==" %%a in ('wmic path win32_localtime get dayofweek /value') do set dow=%%a

IF %dow% == 0 SET day=sleepawokeeatalivexdsleepawokeeatalivexd
IF %dow% == 1 SET day=test1234typingrandomtest1234typingrandom
IF %dow% == 2 SET day=notepadwordpadeasilynotepadwordpadeasily
IF %dow% == 3 SET day=blackwhiteyellowblueblackwhiteyellowblue
IF %dow% == 4 SET day=niceandeasybrocalminniceandeasybrocalmin
IF %dow% == 5 SET day=readingiseasyandfunnreadingiseasyandfunn
IF %dow% == 6 SET day=happypuppycuppymummyhappypuppycuppymummy

echo Inserting %day% and then search!

echo.
title [1/40]
echo [1/40]
adb shell "input text '%day%'; sleep 0.6; input keyevent 66"
timeout 10

